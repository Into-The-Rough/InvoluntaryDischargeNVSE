					"title": "Combat Only",
					"type": 5,
					"enable": 1,
					"mouse": "Hold off firing unless the actor that dropped the weapon is fighting",
					"vars": [{ "configINI": "Main:bCombatOnly", "default": 0 }]
				},
				"3": {
					"title": "Guaranteed Fire",
					"type": 5,
					"enable": 1,
					"mouse": "Skip the condition and luck roll so every dropped weapon goes off. Also makes actors drop their weapon on death. Applies on the next launch.",
					"vars": [{ "configINI": "Main:bGuaranteedFire", "default": 0 }]
				},
				"4": {
					"title": "Ignore Player Drops",
					"type": 5,
					"enable": 1,
					"mouse": "Weapons the player deliberately drops from their inventory never fire. Being disarmed still counts.",
